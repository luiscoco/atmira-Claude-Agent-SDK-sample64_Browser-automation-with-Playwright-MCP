# Copy this file to .env and fill in your key. Never commit .env.
# If ANTHROPIC_API_KEY is empty or missing, the SDK falls back to your Claude Code login.
ANTHROPIC_API_KEY=

# Lesson 61: the bearer token outside MCP clients use for the refund desk (/api/c61/mcp). If empty, a random one is made at startup.
REFUND_DESK_TOKEN=

# Lesson 64: optional path to a Chromium browser; installed Chrome is used by default.
PLAYWRIGHT_MCP_EXECUTABLE_PATH=
